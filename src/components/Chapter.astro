---
// One project "chapter": story on one side, the project's interactive demo on the other.
interface Link { label: string; href: string }
interface Props {
  id: string;
  num: string;
  kicker: string;
  title: string;
  accent: string;
  dark?: boolean;
  flip?: boolean;
  stats?: { value: string; label: string }[];
  stack: string[];
  links?: Link[];
  note?: string;
}
const { id, num, kicker, title, accent, dark = false, flip = false, stats = [], stack, links = [], note } = Astro.props;
---
<section id={id} class:list={["chapter", { dark, flip }]} style={`--accent:${accent}`}>
  <div class="wrap inner">
    <div class="story">
      <p class="eyebrow"><span class="num">{num}</span> {kicker}</p>
      <h2>{title}</h2>
      <div class="body"><slot name="story" /></div>
      {stats.length > 0 && (
        <dl class="stats">
          {stats.map((s) => (<div><dt>{s.value}</dt><dd>{s.label}</dd></div>))}
        </dl>
      )}
      <ul class="stack">{stack.map((t) => <li class="tag">{t}</li>)}</ul>
      {links.length > 0 && (
        <p class="links">
          {links.map((l) => <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">{l.label} →</a>)}
        </p>
      )}
      {note && <p class="note">{note}</p>}
    </div>
    <div class="demo"><slot name="demo" /></div>
  </div>
</section>

<style>
  .chapter { padding: clamp(64px, 9vw, 120px) 0; border-top: 1px solid var(--line); position: relative; }
  .chapter.dark { background: #0d1024; color: #e8e9f5; border-top: 0; --muted: #a1a5c4; --ink-2: #cfd1e6; --paper-2: #1c2142; --line: #262b52; }
  .inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .flip .story { order: 2; }
  @media (max-width: 920px) {
    .inner { grid-template-columns: minmax(0, 1fr); }
    .flip .story { order: 0; }
  }
  .story { position: sticky; top: 32px; }
  @media (max-width: 920px) { .story { position: static; } }
  .num { color: var(--accent); }
  h2 { font-size: clamp(34px, 4.4vw, 54px); margin: 14px 0 20px; font-weight: 650; }
  .body { color: var(--ink-2); display: grid; gap: 14px; }
  .body :global(strong) { color: inherit; font-weight: 650; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 14px; margin: 28px 0 0; }
  .stats div { border-left: 3px solid var(--accent); padding: 2px 0 2px 12px; }
  .stats dt { font: 650 26px/1.1 var(--font-display); }
  .stats dd { margin: 4px 0 0; font-size: 14px; color: var(--muted); line-height: 1.35; }
  .stack { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 7px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 22px; }
  .links a { font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--accent); padding-bottom: 2px; }
  .note { margin-top: 18px; font-size: 13.5px; color: var(--muted); }
  .demo { min-width: 0; }
</style>
