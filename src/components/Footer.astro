---
const links = [
  { label: "Telegram", href: "https://t.me/Licman" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/licman" },
  { label: "GitHub", href: "https://github.com/LicBoy" },
  { label: "LeetCode", href: "https://leetcode.com/u/licman/" },
  { label: "Email", href: "mailto:ahmetvaleevr@gmail.com" },
];
---
<footer class="foot">
  <div class="wrap">
    <h2>Let's talk.</h2>
    <p class="sub">Open to SDET / QA automation roles in fintech, and to freelance projects for small businesses.</p>
    <ul class="links">{links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}</ul>
    <p class="cv">CV: <a href="/cv/Ruslan-Akhmetvaleev-CV-EN.pdf" target="_blank">English</a> · <a href="/cv/Ruslan-Akhmetvaleev-CV-RU.pdf" target="_blank">Русский</a></p>
    <p class="fine mono">© {new Date().getFullYear()} Ruslan Akhmetvaleev · built with Astro</p>
  </div>
</footer>

<style>
  .foot { background: var(--ink); color: var(--paper); padding: clamp(64px, 9vw, 110px) 0 36px; }
  h2 { font-size: clamp(44px, 7vw, 88px); font-weight: 650; }
  .sub { color: #bdb4a6; margin-top: 14px; max-width: 34em; }
  .links { list-style: none; padding: 0; margin: 34px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .links a { display: inline-block; padding: .7em 1.15em; border: 1.5px solid #4a443a; border-radius: 999px; text-decoration: none; font-weight: 600; transition: background .15s, color .15s; }
  .links a:hover { background: var(--paper); color: var(--ink); }
  .cv { margin-top: 26px; color: #bdb4a6; }
  .cv a { color: var(--paper); }
  .fine { margin-top: 56px; font-size: 12.5px; color: #7d756a; }
</style>
