---
// Hero: intro on the left, a Gherkin "test run" of my profile on the right.
const scenarios = [
  {
    name: "A fintech team needs reliable releases",
    steps: [
      ["Given", "payments flow through SWIFT MT and ISO 20022"],
      ["When", "Ruslan automates the regression suite in Kotlin + Cucumber"],
      ["Then", "smoke and E2E testing go from days to hours"],
    ],
  },
  {
    name: "A small business needs its own app",
    steps: [
      ["Given", "a bakery takes orders through chats and paper"],
      ["When", "Ruslan builds it a Telegram Mini App"],
      ["Then", "staff run orders, stock and profit analytics in one place"],
    ],
  },
];
const total = scenarios.reduce((n, s) => n + s.steps.length, 0);
---
<header class="hero">
  <div class="wrap grid">
    <div class="intro">
      <p class="eyebrow">Ruslan Akhmetvaleev · Da Nang, Vietnam · remote</p>
      <h1>I test payment systems for a living. <span class="hl">I build apps for businesses</span> on the side.</h1>
      <p class="lede">
        QA automation engineer (SDET) at CMA Small Systems, working on instant payments and SWIFT / ISO&nbsp;20022
        messaging. In my own time I build products like <a href="#rahat">Rahat Go</a>, an ordering app and CRM that runs
        a bakery inside Telegram.
      </p>
      <div class="cta">
        <a class="btn" href="#work">See the work ↓</a>
        <a class="btn ghost" href="https://t.me/Licman" target="_blank" rel="noopener">Message me</a>
        <a class="btn ghost" href="/cv/Ruslan-Akhmetvaleev-CV-EN.pdf" target="_blank">CV (PDF)</a>
      </div>
    </div>

    <figure class="runner" aria-label="A test run describing my profile: all steps pass">
      <div class="bar">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="file mono">ruslan.feature</span>
        <button class="rerun mono" type="button" aria-label="Run the scenarios again">↻ run</button>
      </div>
      <ol class="code mono">
        <li class="feat"><b>Feature:</b> Hire Ruslan</li>
        {scenarios.map((s) => (
          <>
            <li class="blank"></li>
            <li class="scen"><b>Scenario:</b> {s.name}</li>
            {s.steps.map(([kw, text]) => (
              <li class="step" data-step>
                <span class="kw">{kw}</span> {text}
                <span class="st" aria-hidden="true"></span>
              </li>
            ))}
          </>
        ))}
      </ol>
      <figcaption class="summary mono" aria-live="polite">
        <span class="pill">PASSED</span>
        <span class="sum-text">{scenarios.length} scenarios · {total} steps passed</span>
      </figcaption>
    </figure>
  </div>
</header>

<style>
  .hero { padding: clamp(40px, 8vw, 96px) 0 clamp(56px, 8vw, 110px); }
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (max-width: 920px) { .grid { grid-template-columns: 1fr; } }
  h1 { font-size: clamp(36px, 4.6vw, 58px); margin: 18px 0 22px; font-weight: 650; }
  .hl { background: linear-gradient(transparent 62%, #f6cf8c 62%); }
  .lede { font-size: clamp(17px, 1.6vw, 19px); color: var(--ink-2); max-width: 36em; }
  .lede a { text-decoration-color: var(--accent); text-underline-offset: 3px; text-decoration-thickness: 2px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .runner {
    margin: 0; background: #16140f; color: #e9e3d8; border-radius: var(--radius);
    box-shadow: var(--shadow), 0 30px 60px -30px rgba(25, 23, 20, .5); overflow: hidden; min-width: 0;
  }
  .bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: #211e17; border-bottom: 1px solid #2f2a21; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #3b352a; }
  .file { font-size: 13px; color: #b9b0a1; flex: 1; }
  .rerun { background: none; border: 1px solid #3b352a; color: #d7cfc2; border-radius: 8px; font-size: 12.5px; padding: 5px 10px; cursor: pointer; }
  .rerun:hover { border-color: #6a6050; }
  .code { list-style: none; margin: 0; padding: 18px 18px 8px; font-size: clamp(12px, 1.25vw, 14px); line-height: 1.75; counter-reset: ln; }
  .code li { position: relative; padding-left: 2.6em; padding-right: 4.4em; counter-increment: ln; min-height: 1.75em; }
  .code li::before { content: counter(ln); position: absolute; left: 0; width: 1.6em; text-align: right; color: #575043; }
  .feat b, .scen b { color: #f0b45a; font-weight: 600; }
  .scen { color: #fff; }
  .step { padding-left: 4.2em !important; color: #8d8577; transition: color .25s; }
  .step::before { left: 0 !important; }
  .step .kw { color: #7fb4ff; }
  .step.run { color: #e9e3d8; }
  .step.ok { color: #d9f2e1; }
  .step.ok .kw { color: #4fd18b; }
  .st { position: absolute; right: 0; top: 0; font-size: .9em; color: #6a6050; }
  .step.run .st::after { content: ""; display: inline-block; width: .8em; height: .8em; border: 2px solid #f0b45a; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; vertical-align: -.1em; }
  .step.ok .st { color: #4fd18b; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .summary { display: flex; align-items: center; gap: 12px; padding: 12px 18px 18px; font-size: 13px; color: #b9b0a1; opacity: 0; transition: opacity .4s; }
  .summary.show { opacity: 1; }
  .pill { background: #1f9d55; color: #fff; padding: 4px 9px; border-radius: 6px; font-weight: 700; letter-spacing: .05em; font-size: 11.5px; }
  @media (max-width: 520px) {
    .code li { padding-right: 3.6em; }
    .step { padding-left: 3.2em !important; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".runner");
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const summary = root.querySelector<HTMLElement>(".summary")!;
    const sumText = root.querySelector<HTMLElement>(".sum-text")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let token = 0;

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    async function run() {
      const my = ++token;
      summary.classList.remove("show");
      steps.forEach((s) => { s.className = "step"; s.querySelector(".st")!.textContent = ""; });
      let totalMs = 0;
      for (const s of steps) {
        if (my !== token) return;
        const ms = reduce ? 0 : 260 + Math.round(Math.random() * 380);
        s.classList.add("run");
        await sleep(ms);
        if (my !== token) return;
        s.classList.replace("run", "ok");
        const shown = 40 + Math.round(Math.random() * 160);
        totalMs += shown;
        s.querySelector(".st")!.textContent = `✓ ${shown}ms`;
      }
      sumText.textContent = `2 scenarios · ${steps.length} steps passed · ${(totalMs / 1000).toFixed(2)}s`;
      summary.classList.add("show");
    }

    root.querySelector(".rerun")!.addEventListener("click", run);
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(run, reduce ? 0 : 500); }
    }, { threshold: 0.35 });
    io.observe(root);
  }
</script>
