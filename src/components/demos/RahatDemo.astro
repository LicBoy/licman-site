---
// Rahat Go: "a working phone". One shared state, three roles (Customer / Staff / Owner).
// Everything inside the phone is rendered by the script below from src/data/rahat-menu.json.
const rays = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return `<circle cx="${(20 + Math.cos(a) * 13.2).toFixed(2)}" cy="${(20 + Math.sin(a) * 13.2).toFixed(2)}" r="2.6"/>`;
}).join("");
const logo = `<svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19.5" fill="#fff1d9"/><g fill="#f0a43a">${rays}</g><circle cx="20" cy="20" r="9.2" fill="#e8962a"/><circle cx="20" cy="20" r="5.4" fill="#fff6e6"/></svg>`;
---
<div class="rh" data-rahat>
  <div class="rh-top">
    <div class="rh-seg" role="group" aria-label="Choose a role">
      <span class="rh-seg-pill" aria-hidden="true"></span>
      <button type="button" class="rh-seg-btn" data-role="customer" aria-pressed="true">
        <span class="rh-seg-t">Customer</span><span class="rh-seg-s">orders in Telegram</span>
      </button>
      <button type="button" class="rh-seg-btn" data-role="staff" aria-pressed="false">
        <span class="rh-seg-t">Staff <i class="rh-seg-dot" data-dot="staff" hidden></i></span><span class="rh-seg-s">runs the queue</span>
      </button>
      <button type="button" class="rh-seg-btn" data-role="owner" aria-pressed="false">
        <span class="rh-seg-t">Owner <i class="rh-seg-dot" data-dot="owner" hidden></i></span><span class="rh-seg-s">sees the money</span>
      </button>
    </div>
  </div>

  <div class="rh-body">
    <div class="rh-phone">
      <div class="rh-screen" data-screen>
        <div class="rh-status" aria-hidden="true">
          <span class="rh-time">9:41</span>
          <span class="rh-island"></span>
          <span class="rh-sicons">
            <svg viewBox="0 0 18 12" width="17" height="11"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
            <svg viewBox="0 0 16 12" width="15" height="11"><path d="M8 2.2c2.4 0 4.6.9 6.2 2.5l1.3-1.4A10.6 10.6 0 0 0 8 .3 10.6 10.6 0 0 0 .5 3.3l1.3 1.4A8.7 8.7 0 0 1 8 2.2Zm0 3.6c1.4 0 2.7.5 3.7 1.4l1.3-1.4A7.3 7.3 0 0 0 8 3.9a7.3 7.3 0 0 0-5 1.9l1.3 1.4c1-.9 2.3-1.4 3.7-1.4ZM8 9.3l1.9-2a2.8 2.8 0 0 0-3.8 0l1.9 2Z"/></svg>
            <svg viewBox="0 0 27 12" width="25" height="11"><rect x=".5" y=".5" width="22" height="11" rx="3.2" fill="none" stroke="currentColor" opacity=".45"/><rect x="2.2" y="2.2" width="16" height="7.6" rx="1.8"/><rect x="24" y="4" width="2" height="4" rx="1" opacity=".45"/></svg>
          </span>
        </div>

        <div class="rh-tg">
          <button type="button" class="rh-tg-close" data-act="close" aria-label="Close the mini app (restarts the demo)">
            <svg viewBox="0 0 14 14" width="13" height="13" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            <span>Close</span>
          </button>
          <div class="rh-tg-title"><strong>Rahat Bakery</strong><span>mini app</span></div>
          <button type="button" class="rh-tg-more" data-act="more" aria-label="About this demo" aria-expanded="false">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="6" cy="10" r="1.3"/><circle cx="10" cy="10" r="1.3"/><circle cx="14" cy="10" r="1.3"/></svg>
          </button>
        </div>

        <div class="rh-head">
          <span class="rh-logo" data-logo set:html={logo}></span>
          <div class="rh-brand"><strong>Rahat Bakery</strong><span>Mini App</span></div>
          <span class="rh-pill" data-pill><i></i>Today 00:00 – 23:59</span>
        </div>

        <div class="rh-view" data-view tabindex="-1" aria-label="Mini app screen"></div>

        <nav class="rh-nav" data-nav aria-label="Mini app navigation"></nav>

        <div class="rh-note" data-note aria-hidden="true"></div>

        <div class="rh-pop" data-pop hidden>
          <p><strong>About this phone</strong></p>
          <p>A working replica of Rahat Go built for this page. Dishes, photos and prices are the bakery's real menu; ingredient costs and today's orders are illustrative.</p>
          <button type="button" class="rh-ghost" data-act="close">Restart the demo</button>
        </div>

        <div class="rh-splash" data-splash aria-hidden="true">
          <span class="rh-splash-logo" set:html={logo}></span>
          <strong>Rahat Bakery</strong>
        </div>
      </div>
    </div>

    <aside class="rh-side">
      <p class="rh-side-h">Try the loop <span data-progress>0/4</span></p>
      <ol class="rh-steps" data-steps>
        <li><button type="button" data-goto="customer" data-step="added"><i></i><span><b>Add two dishes</b> as a customer</span></button></li>
        <li><button type="button" data-goto="customer" data-step="placed"><i></i><span><b>Place the order</b> (pickup or delivery)</span></button></li>
        <li><button type="button" data-goto="staff" data-step="completed"><i></i><span><b>Take it to Completed</b> as staff</span></button></li>
        <li><button type="button" data-goto="owner" data-step="played"><i></i><span><b>Try a new price</b> for a dish as owner</span></button></li>
      </ol>
      <button type="button" class="rh-watch" data-act="video">
        <span class="rh-watch-ic" aria-hidden="true"><svg viewBox="0 0 12 14" width="11" height="12"><path d="M1 1.2v11.6c0 .6.7 1 1.2.7l9.3-5.8c.5-.3.5-1 0-1.3L2.2.5C1.7.2 1 .6 1 1.2Z" fill="currentColor"/></svg></span>
        Watch the real app <span class="rh-watch-d">80 s</span>
      </button>
      <p class="rh-fine">Real menu and prices. Ingredient costs and today's orders are illustrative.</p>
    </aside>
  </div>

  <p class="rh-sr" data-live aria-live="polite"></p>

  <dialog class="rh-dlg" data-dlg aria-label="Rahat Go demo video">
    <div class="rh-dlg-in">
      <div class="rh-dlg-top">
        <p><strong>Rahat Go</strong> · the real app, recorded</p>
        <button type="button" class="rh-dlg-x" data-dlg-close aria-label="Close video">
          <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <video controls preload="none" playsinline poster="/media/rahat-go-demo-poster.webp" width="1920" height="1080">
        <source src="/media/rahat-go-demo.mp4" type="video/mp4" />
      </video>
    </div>
  </dialog>
</div>

<script>
  import menu from "../../data/rahat-menu.json";

  interface Ing { name: string; unit: string; qty: number; costPerUnit: number }
  interface Dish { id: number; name: string; price: number; category: string; ingredients: Ing[]; cost: number }
  type Mode = "pickup" | "delivery";
  type Role = "customer" | "staff" | "owner";
  interface Order { code: string; user: string; mode: Mode; items: [number, number][]; at: number; status: number; mine: boolean }

  const DISHES = menu as Dish[];
  const BY_ID = new Map(DISHES.map((d) => [d.id, d]));
  const ROLES: Role[] = ["customer", "staff", "owner"];
  const FEE = 15000;
  const ADDRESS = "An Thuong 4, My An · 3.4 km by road";
  const CATS = ["All", ...Array.from(new Set(DISHES.map((d) => d.category)))];
  const PALETTE = ["#e8962a", "#2a9d8f", "#8c5cd6", "#e76f51", "#3a86c8", "#e9c46a", "#5b8c3a", "#c2577f", "#8a6d4e"];
  // Dishes sold earlier today (illustrative), across 16 completed orders.
  const EARLIER: Record<number, number> = { 13: 7, 14: 5, 9: 2, 22: 6, 24: 3, 21: 4, 1: 3, 7: 2, 11: 2, 46: 3, 51: 2, 56: 4 };
  const EARLIER_ORDERS = 16;

  const fmt = (n: number) => `${Math.round(n).toLocaleString("en-US")} ₫`;
  const pct = (m: number) => `${Math.round(m * 100)}%`;
  const dish = (id: number) => BY_ID.get(id)!;
  const img = (id: number) => `/rahat/dishes/${id}.webp`;
  const sub = (items: [number, number][]) => items.reduce((s, [id, q]) => s + dish(id).price * q, 0);
  const qtyOf = (items: [number, number][]) => items.reduce((s, [, q]) => s + q, 0);
  const tone = (m: number) => (m < 0 ? "neg" : m < 0.4 ? "low" : m < 0.6 ? "mid" : "good");
  const num = (q: number) => (Number.isInteger(q) ? String(q) : q.toFixed(1));
  const stages = (m: Mode) => ["New", "Preparing", m === "pickup" ? "Ready for pickup" : "Out for delivery", "Completed"];
  const actions = (m: Mode) => ["Start preparing", m === "pickup" ? "Mark ready for pickup" : "Hand to courier", "Complete order"];
  const messages = (o: Order) => [
    `we got your order ${o.code}, staff are checking it.`,
    `good news, ${o.code} is being prepared right now.`,
    o.mode === "pickup" ? `${o.code} is ready. Come and pick it up at the bakery.` : `the courier is on the way with ${o.code}.`,
    `${o.code} is completed. Thank you, enjoy your meal!`,
  ];
  const ago = (t: number) => {
    const m = Math.floor((Date.now() - t) / 60000);
    return m < 1 ? "just now" : `${m}m ago`;
  };
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;

  const I = {
    plus: `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M8 2.5v11M2.5 8h11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>`,
    minus: `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2.5 8h11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>`,
    back: `<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    store: `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 9.5 5.4 4h13.2L20 9.5M4 9.5h16M4 9.5c0 1.4 1.1 2.5 2.7 2.5S9.3 10.9 9.3 9.5c0 1.4 1.2 2.5 2.7 2.5s2.7-1.1 2.7-2.5c0 1.4 1.1 2.5 2.6 2.5S20 10.9 20 9.5M5.5 12v8h13v-8M10 20v-4.5h4V20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
    truck: `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2.5 6h11v10h-11zM13.5 9.5h4l3 3.2V16h-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6.5" cy="17" r="1.9" fill="var(--rh-card)" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17" r="1.9" fill="var(--rh-card)" stroke="currentColor" stroke-width="1.6"/></svg>`,
    pin: `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M8 15s5-4.6 5-8.5A5 5 0 0 0 3 6.5C3 10.4 8 15 8 15Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="6.5" r="1.8" fill="currentColor"/></svg>`,
    card: `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><rect x="1.5" y="3.5" width="13" height="9" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M1.5 6.5h13" stroke="currentColor" stroke-width="1.5"/></svg>`,
    qr: `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 2h4.5v4.5H2zM9.5 2H14v4.5H9.5zM2 9.5h4.5V14H2z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M9.5 9.5h2v2h-2zM12 12h2v2h-2zM12 9.5h2v1.5h-2zM9.5 12.5h1.5V14H9.5z" fill="currentColor"/></svg>`,
    check: `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.2 8.4 3 3 6.6-6.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    chev: `<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    menu: `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4.5 15.5c-1.3-3.8 1-8.6 7.5-9.5 6.5.9 8.8 5.7 7.5 9.5-2.4-.9-4.9-1.3-7.5-1.3s-5.1.4-7.5 1.3Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8.2 10 14M15 8.2 14 14M12 6.5V14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>`,
    cart: `<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 4.5h2.4l2.1 10.2h10.2l2-7.2H6.4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.3" cy="19" r="1.5" fill="currentColor"/><circle cx="16.4" cy="19" r="1.5" fill="currentColor"/></svg>`,
    user: `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="8.2" r="3.7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4.8 20c.8-3.7 3.6-5.8 7.2-5.8s6.4 2.1 7.2 5.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
    send: `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M14.5 1.5 1.5 7l5 2 2 5 6-12.5ZM6.5 9l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>`,
  };

  function seedOrders(): Order[] {
    const now = Date.now();
    const o = (code: string, user: string, mode: Mode, items: [number, number][], mins: number, status: number): Order =>
      ({ code, user, mode, items, at: now - mins * 60000, status, mine: false });
    return [
      o("D-0420", "@thu.mai", "delivery", [[11, 2], [56, 1]], 4, 0),
      o("P-0419", "@alex17", "pickup", [[1, 1], [7, 1]], 9, 0),
      o("D-0418", "@sofia_dn", "delivery", [[9, 1], [56, 2]], 18, 1),
      o("P-0417", "@linh.ng", "pickup", [[22, 2], [51, 1]], 26, 2),
    ];
  }

  function init(root: HTMLElement) {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const view = q("[data-view]");
    const nav = q("[data-nav]");
    const pill = q("[data-pill]");
    const note = q("[data-note]");
    const live = q("[data-live]");
    const pop = q("[data-pop]");
    const splash = q("[data-splash]");
    const more = q("[data-act=more]");
    const logoSvg = q("[data-logo]").innerHTML;
    const dlg = q<HTMLDialogElement>("[data-dlg]");
    const video = dlg.querySelector("video")!;
    const segBtns = Array.from(root.querySelectorAll<HTMLButtonElement>(".rh-seg-btn"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const fresh = () => ({
      role: "customer" as Role,
      cat: "All",
      cart: new Map<number, number>(),
      mode: "pickup" as Mode,
      orders: seedOrders(),
      seq: 421,
      lastCode: "",
      justPlaced: false,
      screen: { customer: "menu", staff: "list", owner: "list" } as Record<Role, string>,
      play: new Map<number, number>(),
      dots: { staff: false, owner: false },
      done: { added: false, placed: false, completed: false, played: false } as Record<string, boolean>,
    });
    let S = fresh();
    let lastKey = "";
    let noteTimer = 0;

    const cartItems = (): [number, number][] => Array.from(S.cart.entries()).filter(([, n]) => n > 0);
    const cartCount = () => qtyOf(cartItems());
    const say = (t: string) => { live.textContent = ""; requestAnimationFrame(() => (live.textContent = t)); };

    /* ---------- page builders ---------- */
    function stepper(id: number, small = false) {
      const n = S.cart.get(id) || 0;
      const d = dish(id);
      if (!n) return `<button type="button" class="rh-plus" data-act="inc" data-id="${id}" data-key="inc-${id}" aria-label="Add ${d.name} to cart">${I.plus}</button>`;
      return `<div class="rh-stepper${small ? " sm" : ""}">
        <button type="button" data-act="dec" data-id="${id}" data-key="dec-${id}" aria-label="Remove one ${d.name}">${I.minus}</button>
        <span aria-label="${n} in cart">${n}</span>
        <button type="button" data-act="inc" data-id="${id}" data-key="inc-${id}" aria-label="Add one more ${d.name}">${I.plus}</button>
      </div>`;
    }
    function cartBar() {
      const n = cartCount();
      if (!n) return "";
      return `<button type="button" class="rh-cartbar" data-act="go" data-v="checkout" data-key="cartbar">
        <span class="rh-cb-n">${n}</span><span class="rh-cb-l">${n === 1 ? "item" : "items"} in cart</span>
        <strong>${fmt(sub(cartItems()))}</strong><span class="rh-cb-go">Checkout ${I.chev}</span></button>`;
    }
    function menuPage() {
      const list = DISHES.filter((d) => S.cat === "All" || d.category === S.cat);
      return `
        <section class="rh-hero">
          <div><p class="rh-hero-t">Freshly baked every day</p><p class="rh-hero-s">Tatar &amp; Russian home baking, Da Nang</p></div>
          <span class="rh-hero-sun" aria-hidden="true">${logoSvg}</span>
        </section>
        <h3 class="rh-h" tabindex="-1" data-autofocus>Menu</h3>
        <div class="rh-chips" role="group" aria-label="Filter by category">
          ${CATS.map((c) => `<button type="button" class="rh-chip" data-act="cat" data-v="${c}" data-key="cat-${c}" aria-pressed="${c === S.cat}">${c}</button>`).join("")}
        </div>
        <div class="rh-grid">
          ${list.map((d) => `<article class="rh-card">
            <div class="rh-photo"><img src="${img(d.id)}" alt="" width="480" height="480" loading="lazy" decoding="async"></div>
            <h4>${d.name}</h4>
            <p class="rh-price">${fmt(d.price)}</p>
            <div class="rh-ctl" data-ctl="${d.id}">${stepper(d.id)}</div>
          </article>`).join("")}
        </div>
        <div class="rh-cartslot" data-cartbar>${cartBar()}</div>`;
    }
    function checkoutPage() {
      const items = cartItems();
      const head = `<div class="rh-bar"><button type="button" class="rh-back" data-act="go" data-v="menu" data-key="back" aria-label="Back to menu">${I.back}</button><h3 class="rh-h" tabindex="-1" data-autofocus>Checkout</h3></div>`;
      if (!items.length) {
        return `${head}<div class="rh-empty"><span class="rh-empty-ic">${I.cart}</span><p><strong>Your cart is empty</strong></p><p>Add something warm from the menu first.</p>
          <button type="button" class="rh-cta" data-act="go" data-v="menu" data-key="tomenu">Browse the menu</button></div>`;
      }
      const s = sub(items);
      const fee = S.mode === "delivery" ? FEE : 0;
      const modeBtn = (m: Mode, ic: string, t: string, d: string) =>
        `<button type="button" class="rh-mode" data-act="mode" data-v="${m}" data-key="mode-${m}" aria-pressed="${S.mode === m}">${ic}<b>${t}</b><span>${d}</span></button>`;
      return `${head}
        <p class="rh-label">How would you like to receive it?</p>
        <div class="rh-modes">
          ${modeBtn("pickup", I.store, "Pickup", "At the bakery · free")}
          ${modeBtn("delivery", I.truck, "Delivery", "Courier · by road distance")}
        </div>
        <div class="rh-info">
          ${S.mode === "delivery"
            ? `<p>${I.pin}<span>${ADDRESS}<em>Fee by road distance: ${fmt(FEE)}</em></span></p><p>${I.qr}<span>Pay by bank QR once staff confirm the order</span></p>`
            : `<p>${I.store.replace('width="22" height="22"', 'width="15" height="15"')}<span>Rahat Bakery, Son Tra · ready in about 20 min</span></p><p>${I.card}<span>Pay at the bakery when you collect your order</span></p>`}
        </div>
        <p class="rh-label">Your order</p>
        <ul class="rh-lines">
          ${items.map(([id, n]) => { const d = dish(id); return `<li>
            <img src="${img(id)}" alt="" width="44" height="44">
            <div><b>${d.name}</b><span>${fmt(d.price)}</span></div>
            ${stepper(id, true)}
            <strong>${fmt(d.price * n)}</strong></li>`; }).join("")}
        </ul>
        <dl class="rh-sum">
          <div><dt>Subtotal</dt><dd>${fmt(s)}</dd></div>
          <div><dt>Delivery</dt><dd>${S.mode === "delivery" ? fmt(FEE) : "Pickup · 0 ₫"}</dd></div>
          <div class="rh-total"><dt>Total</dt><dd>${fmt(s + fee)}</dd></div>
        </dl>
        <button type="button" class="rh-cta" data-act="place" data-key="place">Place order · ${fmt(s + fee)}</button>`;
    }
    function tracker(o: Order) {
      const st = stages(o.mode);
      return `<ol class="rh-track">${st.map((t, i) =>
        `<li class="${i < o.status || o.status === 3 ? "done" : i === o.status ? "now" : ""}"><i>${i < o.status || o.status === 3 ? I.check : ""}</i><span>${t}</span></li>`).join("")}</ol>`;
    }
    function trackPage() {
      const mine = S.orders.filter((o) => o.mine);
      const o = mine.find((x) => x.code === S.lastCode) || mine[0];
      if (!o) {
        return `<h3 class="rh-h" tabindex="-1" data-autofocus>My orders</h3>
          <div class="rh-empty"><span class="rh-empty-ic">${I.user}</span><p><strong>No orders yet</strong></p><p>Your orders and their live status show up here.</p>
          <button type="button" class="rh-cta" data-act="go" data-v="menu" data-key="tomenu">Browse the menu</button></div>`;
      }
      const s = sub(o.items);
      const fee = o.mode === "delivery" ? FEE : 0;
      const anim = S.justPlaced ? " pop" : "";
      const others = mine.filter((x) => x !== o);
      return `
        <div class="rh-ok${anim}">
          <span class="rh-ok-ic"><svg viewBox="0 0 52 52" width="52" height="52" aria-hidden="true"><circle cx="26" cy="26" r="24" fill="currentColor" opacity=".14"/><circle cx="26" cy="26" r="17" fill="currentColor"/><path d="m18.5 26.5 5 5 10-11" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <p class="rh-ok-k">${o.status === 3 ? "Order completed" : "Order placed"}</p>
          <h3 class="rh-h rh-code" tabindex="-1" data-autofocus>${o.code}</h3>
          <p class="rh-ok-s">${o.mode === "pickup" ? "Pickup at the bakery" : "Delivery · " + ADDRESS.split(" · ")[0]} · ${plural(qtyOf(o.items), "item")}</p>
        </div>
        <div class="rh-panel">
          <p class="rh-label">Live status</p>
          ${tracker(o)}
          <p class="rh-mini">Each step arrives as a Telegram message from the bakery bot.</p>
        </div>
        <div class="rh-panel">
          ${o.items.map(([id, n]) => `<p class="rh-row"><span>${dish(id).name} <em>×${n}</em></span><span>${fmt(dish(id).price * n)}</span></p>`).join("")}
          ${fee ? `<p class="rh-row muted"><span>Delivery</span><span>${fmt(fee)}</span></p>` : ""}
          <p class="rh-row rh-row-t"><span>Total</span><span>${fmt(s + fee)}</span></p>
        </div>
        ${o.status < 3 ? `<button type="button" class="rh-cta" data-act="role" data-v="staff" data-key="tostaff">Now process it as staff ${I.chev}</button>` : `<button type="button" class="rh-cta" data-act="role" data-v="owner" data-key="toowner">See it in the owner's numbers ${I.chev}</button>`}
        <button type="button" class="rh-ghost" data-act="go" data-v="menu" data-key="again">Order something else</button>
        ${others.length ? `<p class="rh-label">Earlier</p>${others.map((x) => `<p class="rh-row muted"><span>${x.code}</span><span>${stages(x.mode)[x.status]}</span></p>`).join("")}` : ""}`;
    }

    function statusChip(o: Order) {
      return `<span class="rh-st st${o.status}">${stages(o.mode)[o.status]}</span>`;
    }
    function orderCard(o: Order) {
      const n = qtyOf(o.items);
      return `<button type="button" class="rh-oc${o.mine ? " mine" : ""}${o.status === 3 ? " done" : ""}" data-act="open" data-v="${o.code}" data-key="oc-${o.code}">
        <span class="rh-oc-top">${statusChip(o)}${o.mine ? `<span class="rh-newtag">${o.status === 0 ? "New · " : "Your order · "}${ago(o.at)}</span>` : `<span class="rh-ago">${ago(o.at)}</span>`}</span>
        <span class="rh-oc-mid"><b>${o.code}</b><span class="rh-oc-u">${o.mode === "pickup" ? I.store : I.truck}${o.user}</span><span class="rh-oc-n">${plural(n, "item")}</span></span>
        <span class="rh-oc-sum">${fmt(sub(o.items) + (o.mode === "delivery" ? FEE : 0))}</span>
      </button>`;
    }
    function staffList() {
      const active = S.orders.filter((o) => o.status < 3).sort((a, b) => Number(b.mine) - Number(a.mine) || b.at - a.at);
      const done = S.orders.filter((o) => o.status === 3).sort((a, b) => b.at - a.at);
      const hasMine = S.orders.some((o) => o.mine);
      return `<div class="rh-bar"><h3 class="rh-h" tabindex="-1" data-autofocus>Orders</h3><span class="rh-tag">Staff</span></div>
        ${hasMine ? "" : `<div class="rh-hint"><p>Place an order as a customer to see it arrive here.</p><button type="button" class="rh-linkbtn" data-act="role" data-v="customer" data-key="hint">Go to the menu ${I.chev}</button></div>`}
        <p class="rh-label">Active <span class="rh-count">${active.length}</span></p>
        <div class="rh-olist">${active.map(orderCard).join("") || `<p class="rh-mini">Queue is clear. Nice.</p>`}</div>
        ${done.length ? `<p class="rh-label">Completed today <span class="rh-count">${done.length}</span></p><div class="rh-olist">${done.map(orderCard).join("")}</div>` : ""}`;
    }
    function staffOrder(code: string) {
      const o = S.orders.find((x) => x.code === code);
      if (!o) return staffList();
      const s = sub(o.items);
      const fee = o.mode === "delivery" ? FEE : 0;
      const st = stages(o.mode);
      return `<div class="rh-bar"><button type="button" class="rh-back" data-act="go" data-v="list" data-key="back" aria-label="Back to orders">${I.back}</button><h3 class="rh-h" tabindex="-1" data-autofocus>${o.code}</h3>${statusChip(o)}</div>
        <div class="rh-panel rh-od">
          <p class="rh-row"><span class="rh-oc-u">${o.mode === "pickup" ? I.store : I.truck}${o.mode === "pickup" ? "Pickup" : "Delivery"} · ${o.user}</span><span class="rh-ago">${o.mine && o.status === 0 ? "NEW · " : ""}${ago(o.at)}</span></p>
          ${o.mode === "delivery" ? `<p class="rh-row muted"><span class="rh-oc-u">${I.pin}${o.mine ? ADDRESS : "Address shared in chat"}</span></p>` : ""}
        </div>
        <div class="rh-prog" role="img" aria-label="Status: ${st[o.status]}">
          ${st.map((t, i) => `<span class="${i <= o.status ? "on" : ""}${i === o.status ? " cur" : ""}"><i></i><em>${t}</em></span>`).join("")}
        </div>
        <div class="rh-panel">
          <p class="rh-label">Items</p>
          ${o.items.map(([id, n]) => `<p class="rh-row"><span>${dish(id).name}</span><span><em>×${n}</em> ${fmt(dish(id).price * n)}</span></p>`).join("")}
          <p class="rh-row muted rh-sep"><span>Subtotal</span><span>${fmt(s)}</span></p>
          <p class="rh-row muted"><span>Delivery</span><span>${fee ? fmt(fee) : "Pickup · 0 ₫"}</span></p>
          <p class="rh-row rh-row-t"><span>Total</span><span>${fmt(s + fee)}</span></p>
        </div>
        ${o.status < 3
          ? `<button type="button" class="rh-cta" data-act="advance" data-v="${o.code}" data-key="advance">${actions(o.mode)[o.status]}</button>`
          : `<p class="rh-donemsg">${I.check} Completed. The customer has been told.</p><button type="button" class="rh-cta" data-act="go" data-v="list" data-key="back2">Back to orders</button>`}
        <button type="button" class="rh-ghost" data-act="msg" data-v="${o.code}" data-key="msg">${I.send} Message customer</button>`;
    }

    function stats() {
      const sold: Record<number, number> = { ...EARLIER };
      for (const o of S.orders) for (const [id, n] of o.items) sold[id] = (sold[id] || 0) + n;
      let revenue = 0, profit = 0;
      for (const d of DISHES) { const n = sold[d.id] || 0; revenue += n * d.price; profit += n * (d.price - d.cost); }
      const orders = EARLIER_ORDERS + S.orders.length;
      return { sold, revenue, profit, orders, avg: revenue / orders };
    }
    function ownerList() {
      const t = stats();
      const mine = S.orders.filter((o) => o.mine);
      const mineRev = mine.reduce((s, o) => s + sub(o.items), 0);
      const mineProfit = mine.reduce((s, o) => s + o.items.reduce((a, [id, n]) => a + n * (dish(id).price - dish(id).cost), 0), 0);
      const kpi = (k: string, v: string, s: string, hot: boolean) => `<div class="rh-kpi${hot ? " hot" : ""}"><span>${k}</span><b>${v}</b><em>${s}</em></div>`;
      return `<div class="rh-bar"><h3 class="rh-h" tabindex="-1" data-autofocus>Today</h3><span class="rh-tag">Owner</span><span class="rh-illu">illustrative data</span></div>
        <div class="rh-kpis">
          ${kpi("Revenue", fmt(t.revenue), "food sales", mine.length > 0)}
          ${kpi("Orders", String(t.orders), `${S.orders.filter((o) => o.status < 3).length} still active`, mine.length > 0)}
          ${kpi("Average order", fmt(Math.round(t.avg / 1000) * 1000), "per order", mine.length > 0)}
          ${kpi("Gross profit", fmt(t.profit), `${pct(t.profit / t.revenue)} margin`, mine.length > 0)}
        </div>
        ${mine.length
          ? `<p class="rh-yours">${I.check}<span>Includes your ${mine.length > 1 ? "orders" : "order " + mine[0].code}: <b>+${fmt(mineRev)}</b> revenue, <b>+${fmt(mineProfit)}</b> profit. Orders count as soon as they are placed.</span></p>`
          : `<p class="rh-yours idle"><span>Orders count as soon as they are placed. Place one as a customer and watch these move.</span></p>`}
        <p class="rh-label">What every dish earns <span class="rh-label-r">tap a dish</span></p>
        <div class="rh-dlist">
          ${DISHES.map((d) => { const m = (d.price - d.cost) / d.price; return `<button type="button" class="rh-drow" data-act="dish" data-v="${d.id}" data-key="d-${d.id}">
            <img src="${img(d.id)}" alt="" width="40" height="40" loading="lazy">
            <span class="rh-drow-m"><b>${d.name}</b><span>${fmt(d.price)} · cost ${fmt(d.cost)}</span></span>
            <span class="rh-drow-r"><span class="rh-badge ${tone(m)}">${pct(m)}</span><em>${t.sold[d.id] || 0} sold</em></span>
          </button>`; }).join("")}
        </div>
        <p class="rh-mini center">Prices are the real menu. Ingredient costs are illustrative.</p>`;
    }
    function donut(d: Dish) {
      const lines = d.ingredients.map((g) => ({ ...g, c: g.qty * g.costPerUnit })).sort((a, b) => b.c - a.c);
      const total = lines.reduce((s, l) => s + l.c, 0);
      const R = 54, C = 2 * Math.PI * R;
      let off = 0;
      const segs = lines.map((l, i) => {
        const len = (l.c / total) * C;
        const gap = Math.min(2, len * 0.3);
        const s = `<circle r="${R}" cx="70" cy="70" fill="none" stroke="${PALETTE[i % PALETTE.length]}" stroke-width="20" stroke-dasharray="${(len - gap).toFixed(2)} ${(C - len + gap).toFixed(2)}" stroke-dashoffset="${(-off).toFixed(2)}"><title>${l.name}: ${fmt(l.c)}</title></circle>`;
        off += len;
        return s;
      }).join("");
      return { lines, total, svg: `<svg class="rh-donut" viewBox="0 0 140 140" role="img" aria-label="Ingredient cost split for ${d.name}"><g transform="rotate(-90 70 70)">${segs}</g><text x="70" y="64" text-anchor="middle" class="rh-dn-k">Total cost</text><text x="70" y="82" text-anchor="middle" class="rh-dn-v">${fmt(total)}</text></svg>` };
    }
    function ownerDish(id: number) {
      const d = BY_ID.get(id);
      if (!d) return ownerList();
      const p = S.play.get(id) ?? d.price;
      const min = Math.max(1000, Math.round((d.price * 0.4) / 1000) * 1000);
      const max = d.price * 2;
      const dn = donut(d);
      return `<div class="rh-bar"><button type="button" class="rh-back" data-act="go" data-v="list" data-key="back" aria-label="Back to all dishes">${I.back}</button><h3 class="rh-h" tabindex="-1" data-autofocus>${d.name}</h3></div>
        <div class="rh-dhead"><img src="${img(d.id)}" alt="" width="64" height="64"><p>${d.category} · menu price ${fmt(d.price)}<span class="rh-illu">illustrative costs</span></p></div>
        <div class="rh-tiles">
          <div><b data-pg="price">${fmt(p)}</b><span>Price</span></div>
          <div><b>${fmt(d.cost)}</b><span>Cost</span></div>
          <div><b data-pg="profit">${fmt(p - d.cost)}</b><span>Profit</span></div>
          <div><b data-pg="margin">${pct((p - d.cost) / p)}</b><span>Margin</span></div>
        </div>
        <section class="rh-play" aria-label="Price playground">
          <div class="rh-play-h"><p class="rh-label">Price playground</p><button type="button" class="rh-linkbtn" data-act="reset-price" data-v="${id}" data-key="reset">Reset</button></div>
          <div class="rh-play-p"><output data-pg="out">${fmt(p)}</output><span class="rh-badge ${tone((p - d.cost) / p)}" data-pg="badge">${pct((p - d.cost) / p)} margin</span></div>
          <input type="range" class="rh-range" data-act="price" data-id="${id}" data-key="range" min="${min}" max="${max}" step="1000" value="${p}" aria-label="Selling price for ${d.name}" aria-valuetext="${fmt(p)}">
          <div class="rh-range-l"><span>${fmt(min)}</span><span>${fmt(max)}</span></div>
          <div class="rh-split" aria-hidden="true"><i class="c" data-pg="barc"></i><i class="p" data-pg="barp"></i></div>
          <p class="rh-split-l"><span><i class="c"></i>Cost ${fmt(d.cost)}</span><span><i class="p"></i><span data-pg="profit2">Profit ${fmt(p - d.cost)}</span></span></p>
          <p class="rh-mini" data-pg="delta"></p>
        </section>
        <div class="rh-panel rh-cost">
          <p class="rh-label">Where the cost goes</p>
          <div class="rh-cost-in">${dn.svg}
            <ul class="rh-legend">${dn.lines.slice(0, 5).map((l, i) => `<li><i style="background:${PALETTE[i]}"></i><span>${l.name}</span><b>${pct(l.c / dn.total)}</b></li>`).join("")}${dn.lines.length > 5 ? `<li class="muted"><i style="background:#cdbfae"></i><span>+${dn.lines.length - 5} more</span><b>${pct(dn.lines.slice(5).reduce((s, l) => s + l.c, 0) / dn.total)}</b></li>` : ""}</ul>
          </div>
          <table class="rh-ing">
            <thead><tr><th scope="col">Ingredient</th><th scope="col">Qty × cost/unit</th><th scope="col">Line</th></tr></thead>
            <tbody>${dn.lines.map((l, i) => `<tr><td><i style="background:${PALETTE[i % PALETTE.length]}"></i>${l.name}</td><td>${num(l.qty)} ${l.unit} × ${l.costPerUnit.toLocaleString("en-US")}</td><td>${fmt(l.c)}</td></tr>`).join("")}</tbody>
            <tfoot><tr><td colspan="2">Cost per portion</td><td>${fmt(d.cost)}</td></tr></tfoot>
          </table>
        </div>`;
    }

    function page() {
      const sc = S.screen[S.role];
      if (S.role === "customer") return sc === "checkout" ? checkoutPage() : sc === "track" ? trackPage() : menuPage();
      if (S.role === "staff") return sc.startsWith("order:") ? staffOrder(sc.slice(6)) : staffList();
      return sc.startsWith("dish:") ? ownerDish(Number(sc.slice(5))) : ownerList();
    }
    const depth = (sc: string) => (sc === "menu" || sc === "list" ? 0 : sc === "checkout" || sc.includes(":") ? 1 : 2);

    /* ---------- rendering ---------- */
    function renderChrome() {
      const sc = S.screen[S.role];
      const n = cartCount();
      const tab = S.role !== "customer" ? "profile" : sc === "checkout" ? "cart" : sc === "track" ? "profile" : "menu";
      nav.innerHTML = `
        <button type="button" class="rh-nb${tab === "menu" ? " on" : ""}" data-act="nav" data-v="menu" ${tab === "menu" ? 'aria-current="page"' : ""}>${I.menu}<span>Menu</span></button>
        <button type="button" class="rh-nb rh-nb-cart${tab === "cart" ? " on" : ""}" data-act="nav" data-v="cart" ${tab === "cart" ? 'aria-current="page"' : ""} aria-label="Cart, ${plural(n, "item")}"><span class="rh-nb-ball">${I.cart}${n ? `<i class="rh-nb-badge">${n}</i>` : ""}</span><span>Cart</span></button>
        <button type="button" class="rh-nb${tab === "profile" ? " on" : ""}" data-act="nav" data-v="profile" ${tab === "profile" ? 'aria-current="page"' : ""}>${I.user}<span>Profile</span></button>`;
      if (S.role === "customer") pill.innerHTML = `<i></i>Today 00:00 – 23:59`;
      else if (S.role === "staff") pill.innerHTML = `<i></i>${S.orders.filter((o) => o.status < 3).length} active orders`;
      else pill.innerHTML = `<i></i>Open · owner view`;
      pill.dataset.role = S.role;
      segBtns.forEach((b, i) => {
        const on = b.dataset.role === S.role;
        b.setAttribute("aria-pressed", String(on));
        if (on) root.style.setProperty("--rh-seg-i", String(i));
      });
      (["staff", "owner"] as const).forEach((r) => { q(`[data-dot=${r}]`).hidden = !S.dots[r]; });
      const steps = Object.values(S.done).filter(Boolean).length;
      q("[data-progress]").textContent = `${steps}/4`;
      root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) => b.classList.toggle("ok", !!S.done[b.dataset.step!]));
    }

    function render(anim: "" | "fwd" | "back" | "left" | "right" | "up" = "", focusNew = false) {
      const key = `${S.role}:${S.screen[S.role]}`;
      const same = key === lastKey && !anim;
      const top = same ? view.scrollTop : 0;
      const act = document.activeElement as HTMLElement | null;
      const fk = act && view.contains(act) ? act.dataset.key : undefined;
      view.innerHTML = `<div class="rh-pg${anim && !reduce.matches ? " in-" + anim : ""}">${page()}</div>`;
      view.scrollTop = top;
      lastKey = key;
      if (S.role === "owner" && S.screen.owner.startsWith("dish:")) updatePlay(Number(S.screen.owner.slice(5)), false);
      if (fk && same) view.querySelector<HTMLElement>(`[data-key="${CSS.escape(fk)}"]`)?.focus({ preventScroll: true });
      else if (focusNew) view.querySelector<HTMLElement>("[data-autofocus]")?.focus({ preventScroll: true });
      renderChrome();
    }

    function go(sc: string, focusNew = true) {
      const prev = S.screen[S.role];
      if (prev === sc) { view.scrollTo({ top: 0, behavior: reduce.matches ? "auto" : "smooth" }); return; }
      S.screen[S.role] = sc;
      if (sc !== "track") S.justPlaced = false;
      render(depth(sc) >= depth(prev) ? "fwd" : "back", focusNew);
    }

    function setRole(r: Role, focusNew = false) {
      if (r === S.role) return;
      const dir = ROLES.indexOf(r) > ROLES.indexOf(S.role) ? "right" : "left";
      S.role = r;
      if (r !== "customer") S.dots[r] = false;
      S.justPlaced = false;
      hideNote();
      closePop();
      render(dir, focusNew);
      say(r === "customer" ? "Customer view: the menu." : r === "staff" ? "Staff view: the order queue." : "Owner view: today's numbers.");
    }

    /* ---------- cart patching (no full re-render, keeps photos steady) ---------- */
    function patchCart(id: number) {
      const ctl = view.querySelector<HTMLElement>(`[data-ctl="${id}"]`);
      if (!ctl) { render(); return; }
      const act = document.activeElement as HTMLElement | null;
      const fk = act && ctl.contains(act) ? act.dataset.key : undefined;
      ctl.innerHTML = stepper(id);
      if (fk) (ctl.querySelector<HTMLElement>(`[data-key="${fk}"]`) || ctl.querySelector<HTMLElement>("button"))?.focus({ preventScroll: true });
      const bar = view.querySelector<HTMLElement>("[data-cartbar]")!;
      const had = !!bar.firstElementChild;
      bar.innerHTML = cartBar();
      if (!had && bar.firstElementChild && !reduce.matches) bar.firstElementChild.classList.add("enter");
      else if (bar.firstElementChild && !reduce.matches) { const el = bar.firstElementChild as HTMLElement; el.classList.remove("bump"); void el.offsetWidth; el.classList.add("bump"); }
      renderChrome();
    }
    function changeQty(id: number, delta: number) {
      const n = Math.max(0, (S.cart.get(id) || 0) + delta);
      if (n) S.cart.set(id, n); else S.cart.delete(id);
      if (cartCount() >= 2) S.done.added = true;
      const d = dish(id);
      say(delta > 0 ? `${d.name} added. Cart: ${plural(cartCount(), "item")}, ${fmt(sub(cartItems()))}.` : `Removed one ${d.name}. Cart: ${plural(cartCount(), "item")}.`);
      if (S.role === "customer" && S.screen.customer === "menu") patchCart(id); else render();
    }

    /* ---------- notifications (Telegram-style banner inside the phone) ---------- */
    function hideNote() { note.classList.remove("show"); window.clearTimeout(noteTimer); }
    function notify(text: string, meta: string) {
      note.innerHTML = `<span class="rh-note-ic">${logoSvg}</span><div><p class="rh-note-h"><b>Rahat Bakery</b><span>${meta}</span></p><p class="rh-note-t">${text}</p></div>`;
      note.classList.remove("show");
      void note.offsetWidth;
      note.classList.add("show");
      window.clearTimeout(noteTimer);
      noteTimer = window.setTimeout(hideNote, 3800);
      say(`Telegram message: Rahat Bakery: ${text}`);
    }

    /* ---------- actions ---------- */
    function place() {
      const items = cartItems();
      if (!items.length) return;
      const code = `${S.mode === "pickup" ? "P" : "D"}-${String(S.seq++).padStart(4, "0")}`;
      const o: Order = { code, user: "@you", mode: S.mode, items, at: Date.now(), status: 0, mine: true };
      S.orders.unshift(o);
      S.cart.clear();
      S.lastCode = code;
      S.justPlaced = true;
      S.done.placed = true;
      S.dots.staff = true;
      S.dots.owner = true;
      S.screen.customer = "track";
      render("up", true);
      window.setTimeout(() => notify("we got your order, staff are checking it.", "now · to @you"), reduce.matches ? 0 : 420);
    }
    function advance(code: string) {
      const o = S.orders.find((x) => x.code === code);
      if (!o || o.status >= 3) return;
      o.status++;
      if (o.mine && o.status === 3) S.done.completed = true;
      if (o.mine) S.dots.owner = true;
      render();
      const cta = view.querySelector<HTMLElement>("[data-key=advance], [data-key=back2]");
      cta?.focus({ preventScroll: true });
      notify(messages(o)[o.status], `sent to ${o.user}`);
    }
    function updatePlay(id: number, interacted: boolean) {
      const d = dish(id);
      const p = S.play.get(id) ?? d.price;
      const profit = p - d.cost;
      const m = profit / p;
      const set = (k: string, v: string) => { const el = view.querySelector<HTMLElement>(`[data-pg=${k}]`); if (el) el.textContent = v; };
      set("price", fmt(p)); set("out", fmt(p)); set("profit", fmt(profit)); set("margin", pct(m));
      set("profit2", profit >= 0 ? `Profit ${fmt(profit)}` : `Loss ${fmt(-profit)}`);
      const badge = view.querySelector<HTMLElement>("[data-pg=badge]");
      if (badge) { badge.textContent = `${pct(m)} margin`; badge.className = `rh-badge ${tone(m)}`; }
      const share = Math.min(1, d.cost / p);
      const bc = view.querySelector<HTMLElement>("[data-pg=barc]"), bp = view.querySelector<HTMLElement>("[data-pg=barp]");
      if (bc && bp) { bc.style.flexGrow = String(share); bp.style.flexGrow = String(Math.max(0, 1 - share)); bc.classList.toggle("over", profit < 0); }
      const n = stats().sold[id] || 0;
      const diff = (p - d.price) * n;
      set("delta", p === d.price
        ? `At the menu price, today's ${n} sold made ${fmt((d.price - d.cost) * n)} profit. Drag to test a new price.`
        : `If today's ${n} sold had been at this price: ${diff >= 0 ? "+" : "−"}${fmt(Math.abs(diff))} profit vs the menu price${profit < 0 ? ", and every sale loses money" : ""}.`);
      const range = view.querySelector<HTMLInputElement>("[data-key=range]");
      if (range) {
        range.setAttribute("aria-valuetext", `${fmt(p)}, ${pct(m)} margin`);
        const f = (p - Number(range.min)) / (Number(range.max) - Number(range.min));
        range.style.setProperty("--f", `${(f * 100).toFixed(1)}%`);
      }
      if (interacted && p !== d.price && !S.done.played) { S.done.played = true; renderChrome(); }
    }

    function reset() {
      closePop();
      hideNote();
      splash.classList.add("show");
      window.setTimeout(() => {
        S = fresh();
        lastKey = "";
        render();
        say("Mini app restarted.");
      }, reduce.matches ? 0 : 380);
      window.setTimeout(() => splash.classList.remove("show"), reduce.matches ? 50 : 950);
    }
    function closePop() { pop.hidden = true; more.setAttribute("aria-expanded", "false"); }

    root.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const seg = t.closest<HTMLButtonElement>(".rh-seg-btn");
      if (seg) { setRole(seg.dataset.role as Role); return; }
      const step = t.closest<HTMLButtonElement>("[data-goto]");
      if (step) { setRole(step.dataset.goto as Role); return; }
      const b = t.closest<HTMLElement>("[data-act]");
      if (!b || !root.contains(b)) { if (!pop.hidden && !t.closest("[data-pop]")) closePop(); return; }
      const v = b.dataset.v || "";
      const id = Number(b.dataset.id);
      switch (b.dataset.act) {
        case "inc": changeQty(id, 1); break;
        case "dec": changeQty(id, -1); break;
        case "cat": S.cat = v; render(); break;
        case "go": go(v); break;
        case "mode": S.mode = v as Mode; render(); say(v === "delivery" ? `Delivery selected, fee ${fmt(FEE)}.` : "Pickup selected, no fee."); break;
        case "place": place(); break;
        case "role": setRole(v as Role, true); break;
        case "open": go(`order:${v}`); break;
        case "advance": advance(v); break;
        case "msg": { const o = S.orders.find((x) => x.code === v); if (o) notify(`hi! Quick update on ${o.code}: we are on it.`, `sent to ${o.user}`); break; }
        case "dish": go(`dish:${v}`); break;
        case "reset-price": S.play.delete(Number(v)); { const r = view.querySelector<HTMLInputElement>("[data-key=range]"); if (r) r.value = String(dish(Number(v)).price); } updatePlay(Number(v), false); break;
        case "nav":
          if (v === "menu") { if (S.role !== "customer") { S.screen.customer = "menu"; setRole("customer"); } else go("menu"); }
          else if (v === "cart") { if (S.role !== "customer") { S.screen.customer = "checkout"; setRole("customer"); } else go("checkout"); }
          else if (S.role === "customer") go("track"); else go("list");
          break;
        case "close": reset(); break;
        case "more": { const open = pop.hidden; pop.hidden = !open; more.setAttribute("aria-expanded", String(open)); if (open) pop.querySelector("button")?.focus(); break; }
        case "video": dlg.showModal(); break;
      }
    });
    root.addEventListener("input", (e) => {
      const r = e.target as HTMLInputElement;
      if (r.dataset.act !== "price") return;
      S.play.set(Number(r.dataset.id), Number(r.value));
      updatePlay(Number(r.dataset.id), true);
    });
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !pop.hidden) { closePop(); more.focus(); }
    });
    // segmented control: arrow keys move between roles
    q(".rh-seg").addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== "ArrowLeft" && k !== "ArrowRight") return;
      e.preventDefault();
      const i = (ROLES.indexOf(S.role) + (k === "ArrowRight" ? 1 : 2)) % 3;
      setRole(ROLES[i]);
      segBtns[i].focus();
    });

    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    dlg.querySelector("[data-dlg-close]")!.addEventListener("click", () => dlg.close());
    dlg.addEventListener("close", () => video.pause());

    // keep "4m ago" labels honest while the staff queue is on screen
    window.setInterval(() => {
      if (document.hidden || S.role !== "staff") return;
      view.querySelectorAll<HTMLElement>(".rh-oc").forEach((el) => {
        const o = S.orders.find((x) => x.code === el.dataset.v);
        const a = el.querySelector(".rh-ago, .rh-newtag");
        if (o && a) a.textContent = o.mine ? `${o.status === 0 ? "New · " : "Your order · "}${ago(o.at)}` : ago(o.at);
      });
    }, 30000);

    render();
  }

  document.querySelectorAll<HTMLElement>("[data-rahat]").forEach(init);
</script>

<style is:global>
