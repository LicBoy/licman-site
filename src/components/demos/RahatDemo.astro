  .rh-lines { list-style: none; margin: 0; padding: 4px 12px; background: var(--rh-card); border-radius: 16px; box-shadow: 0 0 0 1px var(--rh-line); }
  .rh-lines li { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; grid-template-areas: "i n s" "i n t"; column-gap: 9px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--rh-line); }
  .rh-lines li:last-child { border-bottom: 0; }
  .rh-lines img { grid-area: i; width: 40px; height: 40px; border-radius: 10px; object-fit: cover; }
  .rh-lines li > div:not(.rh-stepper) { grid-area: n; display: grid; min-width: 0; }
  .rh-lines b { font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rh-lines li > div span { font-size: 11.5px; color: var(--rh-muted); }
  .rh-lines .rh-stepper { grid-area: s; justify-self: end; }
  .rh-lines strong { grid-area: t; justify-self: end; font-size: 12.5px; }
  .rh-sum { margin: 0; background: var(--rh-card); border-radius: 16px; padding: 10px 13px; box-shadow: 0 0 0 1px var(--rh-line); display: grid; gap: 5px; }
  .rh-sum div { display: flex; justify-content: space-between; font-size: 13px; color: var(--rh-muted); }
  .rh-sum dd { margin: 0; }
  .rh-sum .rh-total { color: var(--rh-ink); font: 700 16px/1.3 var(--font-body); border-top: 1px solid var(--rh-line); padding-top: 7px; margin-top: 2px; }
  .rh-empty { display: grid; justify-items: center; gap: 4px; text-align: center; padding: 36px 10px; color: var(--rh-muted); }
  .rh-empty strong { color: var(--rh-ink); font-size: 15px; }
  .rh-empty .rh-cta { margin-top: 12px; }
  .rh-empty-ic { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--rh-amber-soft); color: var(--rh-amber-ink); margin-bottom: 6px; }

  /* success / tracking */
  .rh-ok { display: grid; justify-items: center; text-align: center; gap: 2px; padding: 6px 0 2px; }
  .rh-ok-ic { color: var(--rh-green); display: grid; }
  .rh-ok.pop .rh-ok-ic { animation: rh-pop .5s cubic-bezier(.3,1.7,.5,1); }
  .rh-ok.pop .rh-ok-ic path { stroke-dasharray: 30; stroke-dashoffset: 30; animation: rh-draw .45s .25s ease-out forwards; }
  @keyframes rh-draw { to { stroke-dashoffset: 0 } }
  .rh-ok-k { font: 700 11px/1.3 var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: var(--rh-green); margin-top: 4px; }
  .rh-code { font: 700 30px/1.1 var(--font-mono) !important; letter-spacing: -.02em !important; }
  .rh-ok-s { font-size: 12.5px; color: var(--rh-muted); }
  .rh-track { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 0; }
  .rh-track li { position: relative; display: flex; align-items: center; gap: 10px; padding: 5px 0; font-size: 13.5px; color: var(--rh-muted); }
  .rh-track li:not(:last-child)::after { content: ""; position: absolute; left: 10px; top: 26px; height: 12px; width: 2px; background: var(--rh-line); }
  .rh-track li.done:not(:last-child)::after { background: var(--rh-green); }
  .rh-track i { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; border: 2px solid var(--rh-line); background: var(--rh-card); flex: none; }
  .rh-track li.done { color: var(--rh-ink); }
  .rh-track li.done i { background: var(--rh-green); border-color: var(--rh-green); color: #fff; }
  .rh-track li.now { color: var(--rh-ink); font-weight: 650; }
  .rh-track li.now i { border-color: var(--rh-amber-2); box-shadow: 0 0 0 4px rgba(232,150,42,.18); }
  .rh-track li.now i::after { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--rh-amber-2); animation: rh-blink 1.4s infinite; }
  @keyframes rh-blink { 50% { opacity: .25 } }

  /* ---------- staff ---------- */
  .rh-hint { border: 1.5px dashed #ecc58b; background: #fffaf1; border-radius: 16px; padding: 12px 14px; display: grid; gap: 4px; font-size: 13px; color: #6b4e22; }
  .rh-hint .rh-linkbtn { justify-self: start; }
  .rh-olist { display: grid; gap: 9px; }
  .rh-oc { border: 0; text-align: left; background: var(--rh-card); border-radius: 16px; padding: 11px 13px; box-shadow: 0 0 0 1px var(--rh-line); display: grid; gap: 6px; transition: transform .12s, box-shadow .2s; }
  .rh-oc:hover { box-shadow: 0 0 0 1px #e9cfa6, 0 8px 18px -12px rgba(120,70,10,.5); }
  .rh-oc:active { transform: scale(.98); }
  .rh-oc.mine { box-shadow: 0 0 0 2px var(--rh-amber-2), 0 10px 22px -12px rgba(200,110,10,.7); background: linear-gradient(180deg, #fffaf1, #fff); animation: rh-arrive .6s cubic-bezier(.2,.9,.3,1.2); }
  .rh-oc.done { opacity: .72; }
  @keyframes rh-arrive { from { transform: translateY(-14px) scale(.97); opacity: 0 } }
  .rh-oc-top, .rh-oc-mid { display: flex; align-items: center; gap: 8px; }
  .rh-ago { margin-left: auto; font-size: 12px; color: var(--rh-muted); white-space: nowrap; }
  .rh-newtag { margin-left: auto; font: 700 10.5px/1 var(--font-body); letter-spacing: .05em; text-transform: uppercase; color: #fff; background: var(--fail); border-radius: 999px; padding: 4px 8px; white-space: nowrap; }
  .rh-oc-mid b { font: 700 15px/1 var(--font-mono); }
  .rh-oc-u { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; color: var(--rh-muted); min-width: 0; }
  .rh-oc-u svg { width: 15px; height: 15px; flex: none; }
  .rh-oc-n { margin-left: auto; font-size: 11.5px; color: var(--rh-muted); background: #f5eee3; border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
  .rh-oc-sum { color: var(--rh-amber-ink); font-weight: 700; font-size: 15px; }
  .rh-st { font: 700 10px/1 var(--font-body); letter-spacing: .07em; text-transform: uppercase; padding: 4px 8px; border-radius: 6px; white-space: nowrap; }
  .rh-st.st0 { background: #fff1c2; color: #7a5600; }
  .rh-st.st1 { background: #e3ecff; color: #2a4fa8; }
  .rh-st.st2 { background: #efe6ff; color: #6234b8; }
  .rh-st.st3 { background: #dff3e6; color: #17733f; }
  .rh-od { gap: 6px; }
  .rh-prog { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 2px 0; }
  .rh-prog span { display: grid; gap: 6px; justify-items: center; text-align: center; position: relative; }
  .rh-prog i { width: 100%; height: 6px; border-radius: 3px; background: #efe5d6; position: relative; overflow: hidden; }
  .rh-prog i::after { content: ""; position: absolute; inset: 0; background: var(--rh-amber-2); transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .rh-prog .on i::after { transform: scaleX(1); }
  .rh-prog span:last-child.on i::after { background: var(--rh-green); }
  .rh-prog em { font-style: normal; font-size: 10.5px; line-height: 1.2; color: var(--rh-muted); }
  .rh-prog .cur em { color: var(--rh-ink); font-weight: 650; }
  .rh-donemsg { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 0; color: var(--rh-green); font-weight: 600; font-size: 13px; }

  /* ---------- owner ---------- */
  .rh-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .rh-kpi { background: var(--rh-card); border-radius: 16px; padding: 11px 12px; box-shadow: 0 0 0 1px var(--rh-line); display: grid; gap: 2px; min-width: 0; }
  .rh-kpi span { font-size: 11.5px; color: var(--rh-muted); font-weight: 600; }
  .rh-kpi b { font: 700 17px/1.2 var(--font-display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rh-kpi em { font-style: normal; font-size: 11px; color: var(--rh-muted); }
  .rh-kpi.hot { box-shadow: 0 0 0 1.5px #f2c482; }
  .rh-kpi.hot b { animation: rh-flash 1.2s ease-out; }
  @keyframes rh-flash { 0% { color: var(--rh-amber-ink); transform: translateY(4px) } 100% { color: inherit } }
  .rh-yours { margin: 0; display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; line-height: 1.45; padding: 10px 12px; border-radius: 14px; background: #e9f7ee; color: #1d5a35; }
  .rh-yours svg { flex: none; margin-top: 2px; }
  .rh-yours.idle { background: #f5eee3; color: var(--rh-muted); }
  .rh-dlist { display: grid; background: var(--rh-card); border-radius: 16px; box-shadow: 0 0 0 1px var(--rh-line); overflow: hidden; }
  .rh-drow { border: 0; background: none; display: flex; align-items: center; gap: 10px; padding: 9px 12px; text-align: left; border-bottom: 1px solid var(--rh-line); transition: background .15s; }
  .rh-drow:last-child { border-bottom: 0; }
  .rh-drow:hover { background: #fff8ec; }
  .rh-drow:active { background: #fdf0d9; }
  .rh-drow img { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; flex: none; }
  .rh-drow-m { display: grid; min-width: 0; flex: 1; }
  .rh-drow-m b { font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rh-drow-m span { font-size: 11.5px; color: var(--rh-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rh-drow-r { display: grid; justify-items: end; gap: 3px; flex: none; }
  .rh-drow-r em { font-style: normal; font-size: 10.5px; color: var(--rh-muted); }
  .rh-badge { font: 700 11.5px/1 var(--font-body); padding: 4px 7px; border-radius: 7px; white-space: nowrap; transition: background .2s, color .2s; }
  .rh-badge.good { background: #dff3e6; color: #17733f; }
  .rh-badge.mid { background: #fff0cf; color: #85580a; }
  .rh-badge.low { background: #fde2d2; color: #a7400f; }
  .rh-badge.neg { background: #fbdcdc; color: #b42727; }
  .rh-dhead { display: flex; align-items: center; gap: 11px; }
  .rh-dhead img { width: 56px; height: 56px; border-radius: 14px; object-fit: cover; }
  .rh-dhead p { margin: 0; font-size: 12.5px; color: var(--rh-muted); display: grid; gap: 5px; justify-items: start; }
  .rh-dhead .rh-illu { margin-left: 0; }
  .rh-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .rh-tiles div { background: var(--rh-amber-soft); border-radius: 12px; padding: 8px 4px; text-align: center; display: grid; gap: 1px; min-width: 0; }
  .rh-tiles b { font: 700 12.5px/1.2 var(--font-body); color: var(--rh-amber-ink); font-variant-numeric: tabular-nums; }
  .rh-tiles span { font-size: 10.5px; color: var(--rh-muted); }
  .rh-play { background: #221a12; color: #f7efe3; border-radius: 18px; padding: 12px 14px 13px; display: grid; gap: 8px; box-shadow: 0 16px 30px -18px rgba(30,15,0,.8); }
  .rh-play .rh-label { color: #c9b89f; margin: 0; }
  .rh-play .rh-linkbtn { color: #ffc46e; }
  .rh-play .rh-mini { color: #c9b89f; }
  .rh-play-h { display: flex; justify-content: space-between; align-items: center; }
  .rh-play-p { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .rh-play output { font: 700 25px/1.1 var(--font-display); font-variant-numeric: tabular-nums; }
  .rh-range { --f: 50%; -webkit-appearance: none; appearance: none; width: 100%; height: 26px; background: transparent; margin: 0; cursor: pointer; }
  .rh-range::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: linear-gradient(90deg, var(--rh-amber) var(--f), #4a3d2e var(--f)); }
  .rh-range::-moz-range-track { height: 6px; border-radius: 3px; background: linear-gradient(90deg, var(--rh-amber) var(--f), #4a3d2e var(--f)); }
  .rh-range::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -9px; border-radius: 50%; background: #fff; border: 4px solid var(--rh-amber); box-shadow: 0 3px 8px rgba(0,0,0,.4); transition: transform .12s; }
  .rh-range::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 4px solid var(--rh-amber); }
  .rh-range:active::-webkit-slider-thumb { transform: scale(1.15); }
  .rh-range:focus-visible { outline-offset: 4px; border-radius: 8px; }
  .rh-range-l { display: flex; justify-content: space-between; font-size: 11px; color: #a8977f; margin-top: -4px; }
  .rh-split { display: flex; height: 10px; border-radius: 5px; overflow: hidden; gap: 2px; }
  .rh-split i { flex: 1 1 0; transition: flex-grow .2s; min-width: 0; }
  .rh-split .c { background: #8c7b66; }
  .rh-split .c.over { background: #e05a4a; }
  .rh-split .p { background: #3cc47a; }
  .rh-split-l { display: flex; justify-content: space-between; margin: 0; font-size: 12px; color: #e3d6c3; }
  .rh-split-l > span { display: inline-flex; align-items: center; gap: 5px; }
  .rh-split-l i { width: 8px; height: 8px; border-radius: 2px; }
  .rh-split-l i.c { background: #8c7b66; }
  .rh-split-l i.p { background: #3cc47a; }
  .rh-cost { gap: 10px; }
  .rh-cost-in { display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 12px; align-items: center; }
  .rh-donut { width: 128px; height: 128px; }
  .rh-donut circle { transition: opacity .2s; }
  .rh-dn-k { font: 500 9.5px var(--font-body); fill: var(--rh-muted); }
  .rh-dn-v { font: 700 13px var(--font-body); fill: var(--rh-ink); }
  .rh-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 12px; }
  .rh-legend li { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .rh-legend li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rh-legend li b { margin-left: auto; font-weight: 650; font-variant-numeric: tabular-nums; }
  .rh-legend i, .rh-ing i { width: 8px; height: 8px; border-radius: 50%; flex: none; display: inline-block; }
  .rh-legend .muted { color: var(--rh-muted); }
  .rh-ing { width: 100%; border-collapse: collapse; font-size: 12px; font-variant-numeric: tabular-nums; }
  .rh-ing th { text-align: left; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--rh-muted); font-weight: 700; padding: 4px 0; border-bottom: 1px solid var(--rh-line); }
  .rh-ing td { padding: 5px 0; border-bottom: 1px solid #f6efe4; }
  .rh-ing td:first-child i { margin-right: 6px; }
  .rh-ing td:nth-child(2) { color: var(--rh-muted); padding: 5px 6px; }
  .rh-ing th:last-child, .rh-ing td:last-child { text-align: right; white-space: nowrap; }
  .rh-ing tfoot td { font-weight: 700; border-bottom: 0; padding-top: 7px; color: var(--rh-ink); }

  /* ---------- bottom nav ---------- */
  .rh-nav { flex: none; display: grid; grid-template-columns: repeat(3, 1fr); align-items: end; padding: 6px 10px 18px; background: var(--rh-card); border-top: 2px solid var(--rh-amber); position: relative; z-index: 3; }
  .rh-nb { border: 0; background: none; display: grid; justify-items: center; gap: 2px; font-size: 11px !important; color: #8a7e6e !important; padding: 4px 0; border-radius: 10px; transition: color .2s; position: relative; }
  .rh-nb.on { color: var(--rh-amber-ink) !important; font-weight: 650; }
  .rh-nb.on::before { content: ""; position: absolute; top: -8px; width: 22px; height: 3px; border-radius: 2px; background: var(--rh-amber-2); }
  .rh-nb-cart.on::before { display: none; }
  .rh-nb-ball { width: 50px; height: 50px; margin-top: -24px; border-radius: 50%; display: grid; place-items: center; position: relative; background: linear-gradient(180deg, #f7b04c, var(--rh-amber-2)); color: #2b1703; box-shadow: 0 0 0 4px var(--rh-card), 0 8px 16px -6px rgba(200,110,10,.8); transition: transform .15s; }
  .rh-nb-cart:active .rh-nb-ball { transform: scale(.9); }
  .rh-nb-badge { position: absolute; top: -3px; right: -3px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 10px; background: var(--fail); color: #fff; font: 700 11px/20px var(--font-body); font-style: normal; box-shadow: 0 0 0 2px var(--rh-card); animation: rh-pop .3s cubic-bezier(.3,1.6,.5,1); }

  /* ---------- overlays inside the phone ---------- */
  .rh-note {
    position: absolute; left: 10px; right: 10px; top: 50px; z-index: 10; display: flex; gap: 10px; align-items: flex-start;
    padding: 10px 12px; border-radius: 20px; background: rgba(250,250,252,.88); backdrop-filter: blur(16px) saturate(1.6); -webkit-backdrop-filter: blur(16px) saturate(1.6);
    box-shadow: 0 14px 34px -10px rgba(20,15,5,.45), 0 0 0 .5px rgba(0,0,0,.08);
    transform: translateY(-140%); opacity: 0; transition: transform .45s cubic-bezier(.2,.9,.3,1.15), opacity .3s; pointer-events: none;
  }
  .rh-note.show { transform: none; opacity: 1; }
  .rh-note-ic { width: 34px; height: 34px; flex: none; display: grid; border-radius: 9px; overflow: hidden; }
  .rh-note p { margin: 0; }
  .rh-note-h { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; }
  .rh-note-h span { color: #8e8e93; font-size: 11.5px; white-space: nowrap; }
  .rh-note-t { font-size: 13px; line-height: 1.35; color: #2a2620; }
  .rh-pop { position: absolute; right: 12px; top: 92px; z-index: 11; width: min(260px, calc(100% - 24px)); background: var(--rh-card); border-radius: 16px; padding: 14px; display: grid; gap: 8px; font-size: 12.5px; color: var(--rh-muted); box-shadow: 0 20px 40px -12px rgba(20,15,5,.4), 0 0 0 1px var(--rh-line); animation: rh-in-u .25s; }
  .rh-pop[hidden] { display: none; }
  .rh-pop p { margin: 0; }
  .rh-pop strong { color: var(--rh-ink); font-size: 13.5px; }
  .rh-splash { position: absolute; inset: 0; z-index: 20; display: grid; place-content: center; justify-items: center; gap: 10px; background: var(--rh-bg); opacity: 0; pointer-events: none; transition: opacity .3s; font: 700 17px var(--font-display); }
  .rh-splash.show { opacity: 1; pointer-events: auto; }
  .rh-splash-logo { width: 72px; height: 72px; display: grid; }
  .rh-splash.show .rh-splash-logo { animation: rh-spin 1.4s cubic-bezier(.4,0,.2,1); }

  /* ---------- side rail ---------- */
  .rh-side { width: 100%; max-width: 384px; display: grid; gap: 12px; align-content: start; }
  .rh-side-h { font: 650 13px/1 var(--font-body); color: var(--muted); text-transform: uppercase; letter-spacing: .08em; display: flex; justify-content: space-between; }
  .rh-side-h span { font-family: var(--font-mono); color: var(--ink); letter-spacing: 0; }
  .rh-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; counter-reset: rh; }
  .rh-steps button { width: 100%; border: 1px solid var(--line); background: var(--card); border-radius: 12px; padding: 9px 11px; display: flex; gap: 10px; align-items: center; text-align: left; font-size: 13.5px; line-height: 1.35; color: var(--ink-2); transition: border-color .2s, transform .12s, background .2s; counter-increment: rh; }
  .rh-steps button:hover { border-color: var(--accent); }
  .rh-steps button:active { transform: scale(.98); }
  .rh-steps b { color: var(--ink); font-weight: 650; }
  .rh-steps i { width: 22px; height: 22px; flex: none; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid var(--line); font: 600 11px/1 var(--font-mono); font-style: normal; color: var(--muted); transition: background .3s, border-color .3s; }
  .rh-steps i::before { content: counter(rh); }
  .rh-steps .ok { background: #fbf8f1; }
  .rh-steps .ok i { background: var(--pass); border-color: var(--pass); color: #fff; animation: rh-pop .35s cubic-bezier(.3,1.6,.5,1); }
  .rh-steps .ok i::before { content: ""; width: 9px; height: 5px; border: solid #fff; border-width: 0 0 2px 2px; transform: translateY(-1px) rotate(-45deg); }
  .rh-steps .ok b { text-decoration: line-through; text-decoration-color: rgba(31,157,85,.5); }
  .rh-watch { justify-self: start; display: inline-flex; align-items: center; gap: 10px; border: 1.5px solid var(--ink); background: var(--ink); color: var(--paper) !important; border-radius: 999px; padding: 7px 16px 7px 7px; font-weight: 600; font-size: 14px; transition: transform .15s, background .15s; }
  .rh-watch:hover { transform: translateY(-1px); }
  .rh-watch:active { transform: scale(.97); }
  .rh-watch-ic { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: #2b1703; padding-left: 2px; }
  .rh-watch-d { font: 500 12px/1 var(--font-mono); opacity: .7; }
  .rh-fine { font-size: 12.5px; color: var(--muted); line-height: 1.45; }

  /* ---------- video dialog ---------- */
  .rh-dlg { padding: 0; border: 0; background: transparent; width: min(960px, calc(100vw - 24px)); max-width: none; color: #fff; }
  .rh-dlg::backdrop { background: rgba(20,14,6,.72); backdrop-filter: blur(4px); }
  .rh-dlg[open] { animation: rh-in-u .3s cubic-bezier(.2,.8,.2,1); }
  .rh-dlg-in { background: #14110d; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); }
  .rh-dlg-top { display: flex; justify-content: space-between; align-items: center; padding: 10px 10px 10px 16px; font-size: 14px; color: #d8cdbd; }
