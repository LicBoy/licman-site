---
// Hero: statement headline, portrait with floating "product" chips from both worlds (testing and building).
const lines = [
  { text: "I test the software", tone: "fg" },
  { text: "that moves money.", tone: "fg" },
  { text: "And build the apps", tone: "dim" },
  { text: "businesses run on.", tone: "grad" },
];
---
<header class="hero" id="top">
  <div class="wrap grid">
    <div class="copy">
      <p class="who"><span class="dot"></span>Ruslan Akhmetvaleev · QA Automation Engineer · Da Nang, Vietnam</p>
      <h1 aria-label="I test the software that moves money. And build the apps businesses run on.">
        {lines.map((l, i) => (
          <span class:list={["line", l.tone]} style={`--i:${i}`} aria-hidden="true"><span>{l.text}</span></span>
        ))}
      </h1>
      <a class="cue" href="#reel"><span>Scroll</span><i></i></a>
    </div>

    <div class="portrait" data-tilt>
      <div class="frame"><img src="/media/ruslan.webp" alt="Ruslan Akhmetvaleev at the Golden Bridge in Da Nang" width="820" height="1000" fetchpriority="high" decoding="async" /></div>
      <div class="chip c1" aria-hidden="true"><b class="ok">✓</b> 142 tests passed <em>0.9s</em></div>
      <div class="chip c2" aria-hidden="true"><b class="amber">●</b> Order P-0421 placed</div>
      <div class="chip c3" aria-hidden="true"><b class="red">✗</b> Bug caught before release</div>
    </div>
  </div>
</header>

<style>
  .hero { min-height: 100svh; display: flex; align-items: center; padding: 110px 0 60px; position: relative; overflow: hidden; }
  .hero::before { content: ""; position: absolute; width: 900px; height: 900px; right: -200px; top: -150px; background: radial-gradient(circle, rgba(255,140,60,.18), transparent 62%); pointer-events: none; }
  .hero::after { content: ""; position: absolute; width: 800px; height: 800px; left: -300px; bottom: -350px; background: radial-gradient(circle, rgba(52,211,153,.12), transparent 62%); pointer-events: none; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(32px, 5vw, 80px); align-items: center; position: relative; z-index: 1; }
  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .who { display: flex; align-items: center; gap: 10px; font: 500 15px/1.4 var(--font-body); color: var(--d-muted); margin-bottom: 26px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 4px rgba(52,211,153,.18); flex: none; }
  h1 { font-size: clamp(40px, 4.7vw, 80px); font-weight: 700; letter-spacing: -.045em; line-height: .98; }
  /* Clip only vertically (for the rise animation) so a long line is never cut at the column edge. */
  .line { display: block; overflow: hidden; overflow: visible clip; padding-bottom: .06em; }
  /* On desktop lines don't wrap, so cap the size by the column width: Safari sets this font ~10% wider than Chrome. */
  @media (min-width: 901px) { .copy { container-type: inline-size; } h1 { font-size: min(clamp(40px, 4.7vw, 80px), 10cqi); } .line { white-space: nowrap; } }
  .line > span { display: inline-block; transform: translateY(105%); animation: rise .7s cubic-bezier(.2,.7,.1,1) forwards; animation-delay: calc(.05s + var(--i) * .07s); }
  .dim { color: var(--d-muted); }
  .grad > span { background: linear-gradient(90deg, #ffb340, #ff6a5c 50%, #b06cff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @keyframes rise { to { transform: none; } }
  .cue { display: inline-flex; align-items: center; gap: 12px; margin-top: 48px; color: var(--d-muted); text-decoration: none; font-size: 14px; letter-spacing: .08em; text-transform: uppercase; }
  .cue i { width: 22px; height: 36px; border: 2px solid currentColor; border-radius: 12px; position: relative; }
  .cue i::after { content: ""; position: absolute; left: 50%; top: 6px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: currentColor; animation: wheel 1.6s infinite; }
  @keyframes wheel { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }

  .portrait { position: relative; justify-self: center; width: 100%; max-width: 420px; transform-style: preserve-3d; transition: transform .25s ease-out; opacity: 0; animation: fade .8s .1s forwards; }
  @keyframes fade { from { opacity: 0; transform: translateY(30px) scale(.97); } to { opacity: 1; transform: none; } }
  .frame { border-radius: 32px; overflow: hidden; aspect-ratio: 820 / 1000; box-shadow: 0 40px 100px -30px rgba(0,0,0,.8), 0 0 0 1px rgba(255,255,255,.08); }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .chip { position: absolute; display: flex; align-items: center; gap: 9px; padding: 11px 15px; border-radius: 14px; background: rgba(22,22,26,.78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.1); font: 600 14px/1 var(--font-body); color: #f5f5f7; white-space: nowrap; box-shadow: 0 16px 40px -12px rgba(0,0,0,.6); animation: bob 6s ease-in-out infinite; }
  .chip b { font-size: 13px; } .chip em { font-style: normal; color: var(--d-muted); font-weight: 500; }
  .ok { color: #34d399; } .amber { color: #ffb340; } .red { color: #ff6a5c; }
  .c1 { left: -14%; top: 14%; } .c2 { right: -10%; top: 46%; animation-delay: -2s; } .c3 { left: -6%; bottom: 10%; animation-delay: -4s; }
  @media (max-width: 900px) { .hero .portrait { order: -1; max-width: 250px; margin-top: 8px; } .hero { padding-top: 84px; } .c1 { left: -18%; top: 10%; } .c2 { right: -22%; } .c3 { left: -14%; } .chip { font-size: 12px; padding: 8px 11px; } .who { margin-bottom: 18px; } .cue { display: none; } }
  @media (max-width: 360px) { .c2 { right: -8%; } .chip { font-size: 11px; } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @media (prefers-reduced-motion: reduce) { .line > span, .portrait { animation: none; transform: none; opacity: 1; } .chip, .cue i::after { animation: none; } }
</style>

<script>
  const el = document.querySelector<HTMLElement>("[data-tilt]");
  if (el && matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
    el.addEventListener("pointermove", (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      el.style.transform = `perspective(900px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });
    el.addEventListener("pointerleave", () => { el.style.transform = ""; });
  }
</script>
