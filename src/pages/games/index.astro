---
import Games from "../../layouts/Games.astro";
---
<Games title="Licman Games" description="Small mobile games by Ruslan Akhmetvaleev.">
  <h1>Games</h1>
  <p style="margin-bottom:24px">Small, friendly mobile games. No accounts, progress stays on your phone.</p>
  <a class="g-card" href="/games/star-jam/">
    <img src="/games/star-jam/icon.webp" alt="Star Jam icon" width="88" height="88" />
    <div>
      <h2>Star Jam: Rocket Escape <span class="g-badge">In testing</span></h2>
      <p>Launch rockets in the right order and fly every alien home.</p>
    </div>
  </a>
  <a class="g-card" href="/games/shelf-brawlers/" style="margin-top:16px">
    <img src="/games/shelf-brawlers/icon.webp" alt="Shelf Brawlers icon" width="88" height="88" />
    <div>
      <h2>Shelf Brawlers <span class="g-badge">In testing</span></h2>
      <p>Unbox a vinyl toy and brawl through a toy shop after dark.</p>
    </div>
  </a>
  <a class="g-card" href="/games/moon-diner/" style="margin-top:16px">
    <img src="/games/moon-diner/icon.webp" alt="Moon Diner icon" width="88" height="88" />
    <div>
      <h2>Moon Diner: Space Tycoon <span class="g-badge">In testing</span></h2>
      <p>Serve hungry aliens, grow your starship diner and warp from planet to planet.</p>
    </div>
  </a>
</Games>
