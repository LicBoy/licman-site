---
import Base from "../layouts/Base.astro";
import Hero from "../components/v2/Hero.astro";
import Reel from "../components/v2/Reel.astro";
import Work from "../components/v2/Work.astro";
import About from "../components/v2/About.astro";
import Contact from "../components/v2/Contact.astro";
---
<Base>
  <div class="site">
    <nav class="nav" aria-label="Main">
      <div class="wrap row">
        <a class="logo" href="#top" aria-label="Back to top"><span class="tick">✓</span>licman</a>
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
    </nav>
    <main>
      <Hero />
      <Reel />
      <Work />
      <About />
      <Contact />
    </main>
  </div>
</Base>

<style is:global>
  body { background: #070709; }
  .site {
    --d-bg: #070709; --d-fg: #f5f5f7; --d-muted: #8e8e93; --d-line: rgba(255,255,255,.1);
    background: var(--d-bg); color: var(--d-fg); min-height: 100vh;
  }
  .site ::selection { background: rgba(255,179,64,.35); }
</style>
<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 40; background: linear-gradient(rgba(7,7,9,.85), rgba(7,7,9,.55)); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid rgba(255,255,255,.06); }
  .row { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .logo { display: flex; align-items: center; gap: 9px; font: 650 18px/1 var(--font-display); text-decoration: none; color: #f5f5f7; }
  .tick { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: #f5f5f7; color: #0b0b0d; font-size: 14px; font-weight: 800; }
  ul { list-style: none; display: flex; gap: clamp(18px, 3vw, 34px); margin: 0; padding: 0; }
  ul a { color: #d1d1d6; text-decoration: none; font-weight: 550; font-size: 15px; transition: color .15s; }
  ul a:hover { color: #fff; }
</style>
