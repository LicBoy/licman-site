{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "licman-site",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "licman.dev", "custom_domain": true },
    { "pattern": "www.licman.dev", "custom_domain": true }
  ]
}
